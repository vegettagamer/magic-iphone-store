{
  "name": "magic-iphone-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 4174",
    "check": "node --check worker.js && node --check public/admin.js && node --check server/catalog.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "import:catalog": "node scripts/import-catalog.mjs"
  },
  "devDependencies": {
    "wrangler": "4.156.2"
  }
}
